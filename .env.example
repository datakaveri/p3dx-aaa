# Do not commit your real .env. Copy this file to .env and fill values.

PORT=3001

KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_ID=anon-backend
KEYCLOAK_CLIENT_SECRET=

# Application Policy Domain (APD) base URL used by /p3dx/policy proxy
# Example: http://localhost:8082
APD_BASE_URL=

IMMUDB_HOST=127.0.0.1
IMMUDB_PORT=3322
IMMUDB_ADMIN_USER=immudb
IMMUDB_ADMIN_PASSWORD=immudb
IMMUDB_USER=anon_backend
IMMUDB_PASSWORD=
IMMUDB_DATABASE=anon_audit

# Go-based workload contract generator
# Set CONTRACT_GEN_BIN to use a built binary (recommended under systemd).
# If empty, the backend will fall back to `go run .` inside ./contract-gen (dev mode).
CONTRACT_GEN_BIN=

# Optional contract overrides (JSON string). If set, it is passed to the generator as `overrides`
# and merged over the generated defaults. Useful to inject real dataset/app/provider metadata.
CONTRACT_OVERRIDES_JSON=

# Required for generating the user-side consent proof/signature in the contract generator.
# Use a strong random value (e.g. `openssl rand -hex 32`).
CONTRACT_SERVER_SECRET=

# TOP (TEE Orchestration) integration
# If enabled, the backend will POST the generated workload contract to TOP.
TOP_ENABLED=false
# If true, /p3dx/workloads/run fails when TOP submission fails.
TOP_REQUIRED=false
# Base URL of TOP service (example: http://localhost:8090)
TOP_BASE_URL=
# Contract submission endpoint path on TOP
TOP_CONTRACT_ENDPOINT=/contract
# Payload mode: wrapper (default) sends {access_token, signature, contract}; raw sends the generated contract JSON as-is.
TOP_PAYLOAD_MODE=wrapper
# Auth mode: bearer | apikey | none
TOP_AUTH_MODE=bearer
# Used when TOP_AUTH_MODE=apikey
TOP_API_KEY=

# TOP -> backend verification (service-to-service auth)
# TOP calls backend token verification endpoint with header X-API-Key.
TOP_BACKEND_API_KEY=
# Request timeout in ms
TOP_TIMEOUT_MS=10000
