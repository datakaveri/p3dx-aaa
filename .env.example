# =========================
# SERVER
# =========================
PORT=
NODE_ENV=

# =========================
# KEYCLOAK CONFIG
# =========================
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=

KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# =========================
# CORS
# =========================
# Comma-separated list of allowed browser origins
CORS_ORIGINS=

# =========================
# IMMUDB CONFIG
# =========================
IMMUDB_HOST=
IMMUDB_PORT=
IMMUDB_DATABASE=

# Application user (used by the backend at runtime)
IMMUDB_USER=
IMMUDB_PASSWORD=

# Admin user (used only by setup-immudb.mjs to provision the DB and app user)
IMMUDB_ADMIN_USER=
IMMUDB_ADMIN_PASSWORD=

# =========================
# APD (Access Policy Database)
# =========================
APD_BASE_URL=

# =========================
# TOP (Trusted Orchestrator Protocol)
# =========================
# TOP now owns the full contract pipeline (CreateContract, consumer HMAC signing,
# policy gate, orchestrator RSA signing, TEE deployment).
# p3dx-aaa forwards { access_token, dataset_id, application_id } to TOP /workload.

# Enable TOP integration
TOP_ENABLED=
# If true, POST /p3dx/workloads/run fails when TOP submission fails
TOP_REQUIRED=
# Base URL of TOP service (example: http://localhost:8085)
TOP_BASE_URL=
# Shared API key for TOP -> backend service-to-service calls (X-API-Key header)
# Must match BACKEND_API_KEY in Top/.env
TOP_BACKEND_API_KEY=
